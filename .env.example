# Copy this file to .env and fill in only what you use. Every module runs with sensible defaults.

# --- Gemini (ai_client.py) -----------------------------------------------
# Any number of keys: GEMINI_API_KEY-1, GEMINI_API_KEY-2, ... (gaps allowed).
# Quota is per Google Cloud project x model, so keys only add capacity when they
# belong to DIFFERENT projects. A single legacy GEMINI_API_KEY also works.
GEMINI_API_KEY-1=your-key-here
# GEMINI_API_KEY-2=
# GEMINI_MODEL_NAME=gemini-3-flash
# GEMINI_FALLBACK_MODELS=
# GEMINI_QUOTA_SCOPE=project        # project | shared
# GEMINI_DISPLAY_TZ=UTC             # IANA zone used when printing reset times

# --- Router (ai_router.py) ---------------------------------------------
# AI_PROVIDER=gemini                # gemini | groq

# --- Groq (groq_client.py) -----------------------------------------------
# GROQ_API_KEY=
# GROQ_MODEL_NAME=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# --- Agnes (agnes_client.py, agnes_vision_client.py) ----------------------
# AGNES_API_KEY=
# AGNES_BASE_URL=
# AGNES_IMAGE_MODEL=
# AGNES_VIDEO_MODEL=

# --- Qwen / DashScope (qwen_client.py, aliyun_vision_client.py) -----------
# DASHSCOPE_API_KEY=
# QWEN_MODEL_NAME=
# QWEN_ENABLE_THINKING=false

# --- Self-hosted CogVideoX (cogvideox_client.py + notebooks/) -------------
# COGVIDEOX_BASE_URL=https://xxxx.ngrok-free.app
# COGVIDEOX_API_KEY=

# --- Trend research (trend_search.py) -------------------------------------
# YOUTUBE_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=ai-common-toolkit/0.1
